# Vorlage für die .env — die echte Datei wird NICHT eingecheckt (.gitignore).
# Sie liegt neben der docker-compose.yml.

# --- Sitzung -----------------------------------------------------------------
# Signiert das Session-Cookie. In Produktion zwingend setzen, sonst startet die App nicht.
# Erzeugen z. B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Cookie nur über HTTPS senden. Lokal auf leer/0 lassen (der Dev-Server läuft über http),
# sobald die Reverse-Proxy-Regel steht, auf 1 setzen.
COOKIE_SECURE=

# --- Anmeldung über DSM-SSO (OIDC) -------------------------------------------
# Sind diese vier Werte nicht gesetzt, fällt die App außerhalb von Produktion auf ein
# Dev-Login-Formular ohne Passwort zurück. In Produktion verweigert sie den Dienst.
#
# Die Redirect-URI muss ZEICHENGENAU mit der in DSM hinterlegten übereinstimmen —
# eine Abweichung quittiert DSM nur mit "Ungültige SSO-Client-Anwendung", und zwar erst beim
# Token-Austausch, nicht schon bei der Weiterleitung.
OIDC_ISSUER=https://nas.example.com/webman/sso
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://buecherfuchs.example.com/api/auth/callback

# Kommagetrennte DSM-Benutzernamen, die Verwaltungsrechte bekommen.
# Bleibt der Wert leer, wird der zuerst angelegte Nutzer automatisch Admin.
ADMIN_USERNAMES=

# --- Besitzer ----------------------------------------------------------------
# Wem die Bücher gehören, kommagetrennt in der Reihenfolge der Auswahlfelder. Optional mit
# eigener Badge-Farbe hinter einem Doppelpunkt, sonst wird reihum aus der Palette vergeben.
# Hat nichts mit der Anmeldung zu tun: Besitzer brauchen kein Konto.
# Bleibt der Wert leer, gibt es genau einen Besitzer namens "Familie".
BESITZER=Anna,Ben,Clara:#8A4B62

# --- Sprache -----------------------------------------------------------------
# Sprache der Oberfläche: de oder en. OPTIONAL. Leer = die Sprache des Browsers, sonst Deutsch.
# Unter "Mehr" lässt sich die Sprache pro Gerät umstellen; diese Wahl geht immer vor.
SPRACHE=

# --- Buch-APIs ---------------------------------------------------------------
# OPTIONAL. Ohne Schluessel funktioniert alles, aber Google Books zaehlt die Anfrage dann
# gegen ein Kontingent, das sich alle anonymen Aufrufer teilen — und das ist regelmaessig
# erschoepft (Antwort 429, im Log als "Buch-API antwortete mit 429"). Dann traegt allein
# Open Library die Metadaten, was bei deutschsprachigen Titeln spuerbar duenner ausfaellt.
#
# Ein kostenloser Schluessel aus der Google Cloud Console (Books API aktivieren) hebt das auf
# 1000 Abfragen pro Tag — fuer ein Familienregal um Groessenordnungen mehr als noetig.
GOOGLE_BOOKS_API_KEY=

# --- Ablage ------------------------------------------------------------------
# Im Container über das Dockerfile gesetzt; lokal sind die Standards ./data/app.db und ./cover.
# DB_PATH=/app/data/app.db
# COVER_DIR=/app/cover
